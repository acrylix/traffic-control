{
  "name": "ground-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traffic control for your local coding-agent sessions.",
  "scripts": {
    "server": "node server/index.mjs",
    "web": "vite",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && node server/index.mjs",
    "init": "node setup/install.mjs",
    "hostname": "bash setup/hostname.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
